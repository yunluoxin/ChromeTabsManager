{
  "manifest_version": 3,
  "name": "Chrome History Tab Manager",
  "description": "Group open tabs by age, then close, bookmark, or release memory in bulk.",
  "version": "0.1.0",
  "permissions": ["tabs", "bookmarks", "history", "storage", "windows"],
  "incognito": "split",
  "icons": {
    "16": "assets/icon-16.png",
    "32": "assets/icon-32.png",
    "48": "assets/icon-48.png",
    "128": "assets/icon-128.png"
  },
  "action": {
    "default_title": "Tab Manager",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "assets/icon-16.png",
      "32": "assets/icon-32.png",
      "48": "assets/icon-48.png"
    }
  },
  "background": {
    "service_worker": "src/background.js",
    "type": "module"
  },
  "options_page": "dashboard.html"
}
